{
  "normalizacion": {
    "modo": "sin_stopwords"
  },
  "vectorizador": {
    "analyzer": "word",
    "binary": true,
    "decode_error": "strict",
    "dtype": "<class 'numpy.int64'>",
    "encoding": "utf-8",
    "input": "content",
    "lowercase": true,
    "max_df": 0.95,
    "max_features": 30000,
    "min_df": 2,
    "ngram_range": [
      1,
      2
    ],
    "preprocessor": null,
    "stop_words": null,
    "strip_accents": null,
    "token_pattern": "(?u)\\b\\w\\w+\\b",
    "tokenizer": null,
    "vocabulary": null
  },
  "svd": {
    "algorithm": "randomized",
    "n_components": 50,
    "n_iter": 5,
    "n_oversamples": 10,
    "power_iteration_normalizer": "auto",
    "random_state": 0,
    "tol": 0.0
  },
  "norma_l2": {
    "copy": true,
    "norm": "l2"
  },
  "kmeans": {
    "algorithm": "lloyd",
    "copy_x": true,
    "init": "k-means++",
    "max_iter": 300,
    "n_clusters": 12,
    "n_init": 10,
    "random_state": 0,
    "tol": 0.0001,
    "verbose": 0
  }
}
